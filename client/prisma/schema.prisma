generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
  WARDEN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum GroupStatus {
  FORMING
  SUBMITTED
  ALLOTTED
  UNALLOTTED
  DISSOLVED
}

enum RoundStatus {
  DRAFT
  FORMATION_OPEN
  FORMATION_CLOSED
  ALLOCATED
  PUBLISHED
  CLOSED
}

enum TieBreakRule {
  ROLL_NO_ASC
  MAX_CGPA_THEN_ROLL_NO
  GROUP_CREATED_ASC
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id             String   @id @default(uuid())
  supabaseAuthId String   @unique
  email          String   @unique
  role           Role     @default(STUDENT)
  createdAt      DateTime @default(now())
  student        Student?
}

model Student {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  rollNo      String       @unique
  branch      String
  year        Int
  cgpa        Float
  phone       String
  gender      Gender
  address     Json
  application Application?
  groupMember GroupMember?
  allotment   Allotment?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Hostel {
  id        String   @id @default(uuid())
  name      String   @unique
  gender    Gender
  blocks    Block[]
  createdAt DateTime @default(now())
}

model Block {
  id       String @id @default(uuid())
  name     String
  hostelId String
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@unique([name, hostelId])
}

model Room {
  id               String        @id @default(uuid())
  roomNumber       String
  blockId          String
  block            Block         @relation(fields: [blockId], references: [id], onDelete: Cascade)
  floor            Int
  capacity         Int           @default(4)
  status           RoomStatus    @default(AVAILABLE)
  x                Float         @default(0)
  y                Float         @default(0)
  width            Float         @default(80)
  height           Float         @default(80)
  allottedGroupId  String?       @unique
  allottedGroup    StudentGroup? @relation(fields: [allottedGroupId], references: [id], onDelete: SetNull)
  allotments       Allotment[]

  @@unique([roomNumber, blockId])
  @@index([status])
  @@index([blockId])
}

model Application {
  id           String            @id @default(uuid())
  studentId    String            @unique
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       ApplicationStatus @default(DRAFT)
  documents    Json              @default("[]")
  adminRemarks String?
  submittedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model StudentGroup {
  id                String           @id @default(uuid())
  averageCgpa       Float            @default(0.0)
  maxIndividualCgpa Float            @default(0.0)
  status            GroupStatus      @default(FORMING)
  preferences       String[]         @default([])
  roundId           String?
  round             AllocationRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  members           GroupMember[]
  allotments        Allotment[]
  room              Room?
  createdAt         DateTime         @default(now())
  dissolvedAt       DateTime?

  @@index([status])
  @@index([roundId])
}

model Allotment {
  id         String           @id @default(uuid())
  roomId     String
  room       Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  studentId  String           @unique
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId    String?
  group      StudentGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  roundId    String?
  round      AllocationRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  allottedAt DateTime         @default(now())

  @@index([roomId])
  @@index([groupId])
}

model GroupMember {
  id        String       @id @default(uuid())
  studentId String       @unique
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  isLeader  Boolean      @default(false)

  @@index([groupId])
}

model AllocationRound {
  id                String               @id @default(uuid())
  number            Int                  @unique
  status            RoundStatus          @default(DRAFT)
  tieBreakRule      TieBreakRule         @default(MAX_CGPA_THEN_ROLL_NO)
  formationDeadline DateTime?
  startedAt         DateTime?
  publishedAt       DateTime?
  closedAt          DateTime?
  createdAt         DateTime             @default(now())
  groups            StudentGroup[]
  allotments        Allotment[]
  snapshots         RoundGroupSnapshot[]
}

model RoundGroupSnapshot {
  id            String          @id @default(uuid())
  roundId       String
  round         AllocationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  groupId       String
  groupSize     Int
  averageCgpa   Float
  maxCgpa       Float
  rank          Int
  tieBreakNote  String?
  preferences   Json            @default("[]")
  members       Json
  result        String
  roomId        String?
  reason        String?
  createdAt     DateTime        @default(now())

  @@unique([roundId, groupId])
  @@index([roundId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}